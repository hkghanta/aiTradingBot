# Copy to .env and fill in. .env is gitignored.

# --- Alpaca (paper trading) ---
# Create free keys at https://alpaca.markets/ (Paper Trading account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoint. Switch to https://api.alpaca.markets for live (NOT recommended yet).
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Runtime ---
TRADING_BOT_ENV=development
LOG_LEVEL=INFO
